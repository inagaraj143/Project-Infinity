# Copy to .streamlit/secrets.toml (gitignored) or paste into the
# Streamlit Community Cloud "Secrets" box.
#
# All optional. Without a token the app runs on the yfinance feed, which is
# the intended configuration for the hosted build -- Upstox tokens expire
# daily and cannot be refreshed without a browser.

UPSTOX_API_KEY      = ""
UPSTOX_API_SECRET   = ""
UPSTOX_ACCESS_TOKEN = ""
UPSTOX_REDIRECT_URI = "http://localhost:8501"
